<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/kbStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:text="Ready for on-device dictation." />

    <Button
        android:id="@+id/kbMic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dictate" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/kbLanguage" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="English" />
        <Button android:id="@+id/kbSettings" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Settings" />
        <Button android:id="@+id/kbSwitch" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Switch keyboard" />
    </LinearLayout>
</LinearLayout>
