<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/swar_paper" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/swar_card" android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/swar_accent" android:textStyle="bold" android:textSize="13sp" />
        <TextView android:id="@+id/kbStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="@color/swar_ink" android:accessibilityLiveRegion="polite"
            android:text="@string/keyboard_ready" />
        <com.google.android.material.button.MaterialButton
    android:id="@+id/kbMic"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:text="@string/keyboard_dictate"  />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton android:id="@+id/kbLanguage"
                style="@style/Widget.SwarScribe.Secondary" android:layout_width="0dp"
                android:layout_weight="1" android:layout_marginHorizontal="2dp" android:layout_height="wrap_content"
                android:paddingHorizontal="4dp" android:insetLeft="0dp" android:insetRight="0dp" android:text="@string/language_english" />
            <com.google.android.material.button.MaterialButton android:id="@+id/kbSettings"
                style="@style/Widget.SwarScribe.Secondary" android:layout_width="0dp"
                android:layout_weight="1" android:layout_marginHorizontal="2dp" android:layout_height="wrap_content"
                android:paddingHorizontal="4dp" android:insetLeft="0dp" android:insetRight="0dp" android:text="@string/keyboard_settings" />
            <com.google.android.material.button.MaterialButton android:id="@+id/kbSwitch"
                style="@style/Widget.SwarScribe.Secondary" android:layout_width="0dp"
                android:layout_weight="1" android:layout_marginHorizontal="2dp" android:layout_height="wrap_content"
                android:paddingHorizontal="4dp" android:insetLeft="0dp" android:insetRight="0dp" android:text="@string/keyboard_switch" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
